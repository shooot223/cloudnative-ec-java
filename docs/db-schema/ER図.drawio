        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    users ||--o| user_saved_addresses : \&quot;1:0..1\&quot;\n    users ||--o| user_saved_test_cards : \&quot;1:0..1\&quot;\n    users ||--o| carts : \&quot;1:0..1\&quot;\n    users ||--o{ cart_merge_logs : \&quot;1:N\&quot;\n    users ||--o{ orders : \&quot;1:N\&quot;\n    carts |o--o{ carts : \&quot;pending_merge_cart_id\&quot;\n    carts ||--o{ cart_items : \&quot;1:N\&quot;\n    carts ||--o{ cart_merge_logs : \&quot;target/source\&quot;\n    products ||--o{ cart_items : \&quot;1:N\&quot;\n    products ||--o{ order_items : \&quot;1:N\&quot;\n    orders ||--|{ order_items : \&quot;1:N\&quot;\n    admins ||--o{ product_image_uploads : \&quot;1:N\&quot;\n\n    users {\n        BIGINT id PK\n        VARCHAR_128 cognito_sub UK\n        VARCHAR_50 name\n        VARCHAR_254 email UK\n        VARCHAR_20 status\n        TIMESTAMP_3 created_at\n        TIMESTAMP_3 updated_at\n    }\n    admins {\n        BIGINT id PK\n        VARCHAR_128 cognito_sub UK\n        VARCHAR_254 email UK\n        VARCHAR_50 display_name\n        VARCHAR_30 role\n        VARCHAR_20 status\n        TIMESTAMP_3 created_at\n        TIMESTAMP_3 updated_at\n    }\n    user_saved_addresses {\n        BIGINT id PK\n        BIGINT user_id FK_UK\n        VARCHAR_50 recipient_name\n        CHAR_7 postal_code\n        VARCHAR_10 prefecture\n        VARCHAR_100 city_street\n        VARCHAR_100 building\n        VARCHAR_11 phone_number\n        BIGINT version\n        TIMESTAMP_3 created_at\n        TIMESTAMP_3 updated_at\n    }\n    user_saved_test_cards {\n        BIGINT id PK\n        BIGINT user_id FK_UK\n        CHAR_16 card_number\n        CHAR_4 last4_digits\n        VARCHAR_50 card_display_name\n        BIGINT version\n        TIMESTAMP_3 created_at\n        TIMESTAMP_3 updated_at\n    }\n    products {\n        BIGINT id PK\n        VARCHAR_100 name\n        VARCHAR_200 summary\n        VARCHAR_2000 description\n        INTEGER price_excluding_tax\n        SMALLINT tax_rate\n        INTEGER price_including_tax\n        INTEGER stock_quantity\n        VARCHAR_20 publish_status\n        VARCHAR_20 sales_status\n        VARCHAR_512 image_s3_key\n        BOOLEAN is_deleted\n        TIMESTAMP_3 deleted_at\n        BIGINT version\n        TIMESTAMP_3 created_at\n        TIMESTAMP_3 updated_at\n    }\n    product_image_uploads {\n        VARCHAR_64 upload_operation_id PK\n        BIGINT admin_id FK\n        VARCHAR_512 s3_object_key UK\n        VARCHAR_255 original_filename\n        VARCHAR_50 mime_type\n        INTEGER file_size\n        VARCHAR_20 status\n        TIMESTAMP_3 created_at\n        TIMESTAMP_3 updated_at\n    }\n    carts {\n        BIGINT id PK\n        BIGINT user_id FK_UK\n        VARCHAR_64 guest_cart_token UK\n        VARCHAR_20 status\n        BIGINT pending_merge_cart_id FK\n        BIGINT version\n        TIMESTAMP_3 expires_at\n        TIMESTAMP_3 created_at\n        TIMESTAMP_3 updated_at\n    }\n    cart_items {\n        BIGINT id PK\n        BIGINT cart_id FK\n        BIGINT product_id FK\n        INTEGER quantity\n        VARCHAR_100 added_product_name\n        INTEGER added_price_including_tax\n        TIMESTAMP_3 created_at\n        TIMESTAMP_3 updated_at\n    }\n    cart_merge_logs {\n        BIGINT id PK\n        BIGINT user_id FK\n        BIGINT target_cart_id FK\n        BIGINT source_cart_id FK\n        VARCHAR_20 merge_status\n        BOOLEAN has_adjustments\n        JSONB adjustments_json\n        BOOLEAN is_acknowledged\n        TIMESTAMP_3 created_at\n        TIMESTAMP_3 updated_at\n    }\n    orders {\n        BIGINT id PK\n        VARCHAR_32 order_number UK\n        BIGINT user_id FK\n        VARCHAR_20 order_status\n        INTEGER total_item_quantity\n        INTEGER subtotal_including_tax\n        INTEGER shipping_fee_including_tax\n        INTEGER payment_fee_including_tax\n        INTEGER total_amount_including_tax\n        VARCHAR_50 purchaser_name\n        VARCHAR_254 purchaser_email\n        VARCHAR_50 recipient_name\n        CHAR_7 recipient_postal_code\n        VARCHAR_10 recipient_prefecture\n        VARCHAR_100 recipient_city_street\n        VARCHAR_100 recipient_building\n        VARCHAR_11 recipient_phone_number\n        VARCHAR_50 payment_method_name\n        CHAR_16 test_card_number_snapshot\n        VARCHAR_50 test_card_display_name\n        CHAR_4 test_card_last4\n        VARCHAR_20 mock_payment_status\n        VARCHAR_20 mock_refund_status\n        INTEGER mock_refund_amount\n        BOOLEAN save_address_requested\n        VARCHAR_20 save_address_result\n        BOOLEAN save_card_requested\n        VARCHAR_20 save_card_result\n        TIMESTAMP_3 cancelled_at\n        VARCHAR_200 cancel_reason\n        BIGINT version\n        TIMESTAMP_3 ordered_at\n        TIMESTAMP_3 updated_at\n    }\n    order_items {\n        BIGINT id PK\n        BIGINT order_id FK\n        INTEGER line_number\n        BIGINT product_id FK\n        VARCHAR_100 product_name_snapshot\n        INTEGER unit_price_excluding_tax_snapshot\n        SMALLINT tax_rate_snapshot\n        INTEGER unit_price_including_tax_snapshot\n        INTEGER quantity\n        INTEGER subtotal_including_tax_snapshot\n        TIMESTAMP_3 created_at\n    }\n    operation_histories {\n        VARCHAR_64 operation_id PK\n        VARCHAR_40 operation_type\n        VARCHAR_20 actor_type\n        VARCHAR_64 actor_id\n        BIGINT target_resource_id\n        VARCHAR_20 operation_status\n        BOOLEAN is_retryable\n        VARCHAR_50 result_code\n        JSONB result_summary_json\n        TIMESTAMP_3 expires_at\n        TIMESTAMP_3 created_at\n        TIMESTAMP_3 updated_at\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="kIo1U1wcvd8d5QwZXKnM-1">
